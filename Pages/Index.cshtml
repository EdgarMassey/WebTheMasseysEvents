@page
@model WebTheMasseysEvents.Pages.IndexModel

<div class="container py-5">

    <!-- Header -->
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">
            The Swedish Massey Family blog
        </h1>
    </div>

    @*
    <p class="privacy-quote">
        The Events and Pictures full option includes approximately 9000 pictures
        collected monthly over 28 years of our family life.

        These pictures are organized by year and month, allowing those interested
        to explore our family's journey through these years. 'Highlights' selects
        all events with text info.
    </p>
    *@

    <!-- Clickable family image -->
    <div class="text-center mb-4">
        <button type="button"
                class="index-footer-link p-0 border-0 bg-transparent"
                data-bs-toggle="modal"
                data-bs-target="#indexImageModal"
                aria-label="Open image full size">

            <img src="/Photos/Us2026.jpg"
                 alt="Family photo"
                 class="index-footer-image fade-in" />
        </button>
    </div>

    <!-- Navigation cards -->
    <div class="row g-4 mb-5">

        <!-- Our Kids -->
        <div class="col-md-4">
            <div class="card shadow-sm text-center position-relative h-100">

                <div style="font-size: 1.6rem;">
                    👨‍👩‍👧‍👦
                </div>

                <h3 class="mt-2 mb-0">
                    Our Kids
                </h3>

                <a asp-page="/OurKids"
                   class="stretched-link"
                   aria-label="Open Our Kids">
                </a>

            </div>
        </div>

        <!-- Our Home -->
        <div class="col-md-4">
            <div class="card shadow-sm text-center position-relative h-100">

                <div style="font-size: 1.6rem;">
                    🏠
                </div>

                <h3 class="mt-2 mb-0">
                    Our Home
                </h3>

                <a asp-page="/Home"
                   class="stretched-link"
                   aria-label="Open Our Home">
                </a>

            </div>
        </div>

        <!-- Events and pictures -->
        <div class="col-md-4">
            <div class="card shadow-sm text-center position-relative h-100">

                <div style="font-size: 1.6rem;">
                    📅
                </div>

                <h3 class="mt-2 mb-0">
                    Events and pictures
                </h3>

                @if (Model.ShowEventsNewBadge)
                {
                    <div class="mt-2">
                        <span class="badge bg-success">
                            NEW
                        </span>
                    </div>
                }

                <a href="/events"
                   class="stretched-link"
                   aria-label="Open Events and pictures">
                </a>

            </div>
        </div>

    </div>

    <!-- Family image modal -->
    <div class="modal fade"
         id="indexImageModal"
         tabindex="-1"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-transparent border-0">

                <button type="button"
                        class="btn-close btn-close-white ms-auto me-2 mt-2"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

                <img src="/Photos/Us2026.jpg"
                     class="img-fluid rounded"
                     alt="Family photo full size" />

            </div>
        </div>
    </div>

    <img src="https://www.themasseys.net/Familypix/Writings.asp?id=Events"
         alt=""
         style="display:none" />

</div>